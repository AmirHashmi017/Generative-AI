      "name": "Flatten Emails"
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const arr = item.json.emails;\n  if (Array.isArray(arr)) {\n    for (const em of arr) out.push({ json: { email: em } });\n  } else if (arr) {\n    out.push({ json: { email: arr } });\n  }\n}\nreturn out;"
      },
