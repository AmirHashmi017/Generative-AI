    {
      "parameters": {
        "jsCode": "const all = [];\nfor (const item of $input.all()) {\n  const e = item.json.emails;\n  if (Array.isArray(e)) all.push(...e);\n  else if (e) all.push(e);\n}\nconst unique = [...new Set(all.filter(Boolean))];\nreturn [{ json: { emails: unique } }];"
      },
